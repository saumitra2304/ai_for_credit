# Copy to the repo-root .env (gitignored). Never commit real keys.

probe_api_key=
INSTA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5.4-nano
# Leave unset to use https://api.openai.com/v1
# OPENAI_BASE_URL=

INTERNAL_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Public hostname of this EC2 box (needed for HTTPS / Let's Encrypt)
DOMAIN=api.example.com

AUTH_ALLOW_REGISTER=true
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password
AUTH_BOOTSTRAP_NAME=Admin

# Production: set AUTH_ALLOW_REGISTER=false after the bootstrap admin exists.
# INTERNAL_TOKEN must be a long random secret; nginx uses it for the Probe API.

# Concurrent load (one uvicorn worker + SQLite — raise carefully)
# PROBE_CONCURRENCY=16
# CHAT_LLM_CONCURRENCY=8
# MEMO_CONCURRENCY=2
# PROBE_UPSTREAM_CONCURRENCY=20

# Grafana on the compose host (bound to localhost:3001)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
