proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
proxy_set_header Authorization $http_authorization;
proxy_read_timeout 600s;
proxy_send_timeout 600s;

location = /health {
    proxy_pass http://127.0.0.1:8001/health;
}

location = /metrics {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    proxy_pass http://127.0.0.1:8001/metrics;
}

location = /sme-metrics {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    proxy_pass http://127.0.0.1:3000/internal/metrics;
}

location = /internal-auth-check {
    internal;
    proxy_pass http://127.0.0.1:8001/auth/me;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Content-Type "";
    proxy_set_header Authorization $http_authorization;
}

location ^~ /internal {
    return 404;
}

location /api/search/ {
    auth_request $search_auth;
    error_page 401 = @search_cors_401;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_pass http://127.0.0.1:3000;
    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials true always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
}

location @search_cors_401 {
    add_header Access-Control-Allow-Origin $http_origin always;
    add_header Access-Control-Allow-Credentials true always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    default_type application/json;
    return 401 '{"detail":"Invalid or expired session."}';
}

location /api/chat_history {
    rewrite ^/api/chat_history(.*)$ /chat_history$1 break;
    proxy_pass http://127.0.0.1:8001;
    proxy_buffering off;
    proxy_cache off;
}

location /api/auth/ {
    rewrite ^/api/auth/(.*)$ /auth/$1 break;
    proxy_pass http://127.0.0.1:8001;
}

location = /api/auth {
    rewrite ^/api/auth$ /auth break;
    proxy_pass http://127.0.0.1:8001;
}

location /api/admin/ {
    rewrite ^/api/admin/(.*)$ /admin/$1 break;
    proxy_pass http://127.0.0.1:8001;
}

location = /api/admin {
    rewrite ^/api/admin$ /admin break;
    proxy_pass http://127.0.0.1:8001;
}

location /api/chat {
    rewrite ^/api/chat(.*)$ /chat$1 break;
    proxy_pass http://127.0.0.1:8001;
    proxy_buffering off;
    proxy_cache off;
    add_header X-Accel-Buffering no;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
